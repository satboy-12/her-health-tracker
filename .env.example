# External Java Spring Boot REST API Base URL
# Local Spring Boot dev: http://localhost:8080
# Vercel production (must be HTTPS): https://your-spring-boot-api.example.com
# Leave empty only if /api/* is reverse-proxied on the same origin.
VITE_API_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
